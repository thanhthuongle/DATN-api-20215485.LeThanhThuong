  financial_spaces       financial_spaces @relation(fields: [financial_space_id], references: [id], onUpdate: NoAction, map: "accounts_space_id_fkey")
  ledger_accounts        ledger_accounts?

  @@index([bank_id])
  @@index([financial_space_id, status, created_at, id])
}

