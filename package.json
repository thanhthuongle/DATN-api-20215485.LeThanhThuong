{
  "name": "nodejs-expressjs-mongodb-base-project",
  "private": true,
  "version": "1.0.0",
  "author": "Le Thanh Thuong - 20215485",
  "description": "DATN-API",
  "engines": {
    "node": ">=20.19.0"
  },
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "preinstall": "node scripts/enforce-package-manager.cjs",
    "verify:package-manager": "node scripts/verify-package-manager.cjs",
    "lint": "eslint src --ext js --report-unused-disable-directives --max-warnings 0",
    "clean": "node scripts/clean-build.cjs",
    "build-babel": "babel ./src -d ./build/src --extensions .js,.ts",
    "build": "yarn prisma:generate && yarn clean && yarn build-babel",
    "verify:phase1:api": "yarn build && node scripts/verify-api-versioning.cjs",
    "verify:phase1:flags": "yarn build && node scripts/verify-feature-flags.cjs",
    "verify:phase1:contracts": "node scripts/verify-openapi-baseline.cjs",
    "verify:phase1:boundaries": "yarn build && node scripts/verify-api-boundaries.cjs",
    "verify:phase1": "yarn build && node scripts/verify-api-versioning.cjs && node scripts/verify-feature-flags.cjs && node scripts/verify-openapi-baseline.cjs && node scripts/verify-api-boundaries.cjs",
    "prisma:generate": "cross-env POSTGRESQL_DIRECT_URL=postgresql://prisma_generate:prisma_generate@localhost:5432/prisma_generate?schema=public prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "prisma db seed",
    "db:health:v2": "yarn build && node scripts/verify-postgres-health.cjs",
    "db:local:migrate": "cross-env POSTGRESQL_DATABASE_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public POSTGRESQL_DIRECT_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public prisma migrate deploy",
    "db:local:seed": "cross-env POSTGRESQL_DATABASE_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public POSTGRESQL_DIRECT_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public prisma db seed",
    "db:local:health": "cross-env POSTGRESQL_DATABASE_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public POSTGRESQL_DIRECT_URL=postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public yarn db:health:v2",
    "db:verify:wave2-schema": "node scripts/verify-wave2-schema.cjs",
    "db:dry-run:wave2": "node scripts/run-wave2-controlled-dry-run.cjs",
    "db:verify:wave2-financial-guards": "node scripts/verify-wave2-financial-guards.cjs",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "test:coverage": "vitest run --coverage",
    "production": "yarn build && cross-env BUILD_MODE=production node ./build/src/server.js",
    "dev": "cross-env BUILD_MODE=dev nodemon --exec babel-node --extensions .js,.ts ./src/server.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.22.10",
    "@getbrevo/brevo": "^2.2.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "agenda": "^5.0.0",
    "async-exit-hook": "^2.0.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "http-status-codes": "^2.3.0",
    "joi": "^17.10.2",
    "jsonwebtoken": "^9.0.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "mongodb": "^6.0.0",
    "ms": "^2.1.3",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.16.3",
    "redis": "^5.11.0",
    "socket.io": "^4.7.4",
    "streamifier": "^0.1.1",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.22.10",
    "@babel/core": "^7.22.10",
    "@babel/eslint-parser": "^7.22.10",
    "@babel/node": "^7.22.10",
    "@babel/plugin-transform-runtime": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/preset-typescript": "^7.29.0",
    "@testcontainers/mongodb": "12.0.4",
    "@testcontainers/postgresql": "12.0.4",
    "@testcontainers/redis": "12.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.47.0",
    "js-yaml": "5.2.3",
    "nodemon": "^3.0.1",
    "prisma": "7.9.1",
    "supertest": "7.2.2",
    "testcontainers": "12.0.4",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
