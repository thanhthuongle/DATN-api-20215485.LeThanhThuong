generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  previewFeatures        = ["partialIndexes"]
  generatedFileExtension = "ts"
  importFileExtension    = ""
  moduleFormat           = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model account_balance_snapshots {
  id                              BigInt                      @id @default(autoincrement())
  public_id                       String                      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  snapshot_run_id                 BigInt
  ledger_account_id               BigInt
  financial_space_id              BigInt
  business_date                   DateTime                    @db.Date
  period_start_utc                DateTime                    @db.Timestamptz(6)
  period_end_utc                  DateTime                    @db.Timestamptz(6)
  opening_balance                 BigInt
  total_inflow                    BigInt
  total_outflow                   BigInt
  closing_balance                 BigInt
  first_entry_sequence            BigInt?
  last_entry_sequence             BigInt?
  cutoff_sequence                 BigInt
  cutoff_posted_at                DateTime                    @db.Timestamptz(6)
  entry_count                     Int
  calculation_version             Int
  checksum                        String                      @db.Char(64)
  status                          balance_snapshot_status
  is_current                      Boolean                     @default(false)
  superseded_by_id                BigInt?
  superseded_at                   DateTime?                   @db.Timestamptz(6)
  generated_at                    DateTime                    @db.Timestamptz(6)
  created_at                      DateTime                    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  updated_at                      DateTime                    @default(dbgenerated("clock_timestamp()")) @db.Timestamptz(6)
  ledger_accounts                 ledger_accounts             @relation(fields: [ledger_account_id], references: [id], onUpdate: NoAction, map: "balance_snapshots_ledger_id_fkey")
  balance_snapshot_runs           balance_snapshot_runs       @relation(fields: [snapshot_run_id], references: [id], onUpdate: NoAction, map: "balance_snapshots_run_id_fkey")
  financial_spaces                financial_spaces            @relation(fields: [financial_space_id], references: [id], onUpdate: NoAction, map: "balance_snapshots_space_id_fkey")
  account_balance_snapshots       account_balance_snapshots?  @relation("account_balance_snapshotsToaccount_balance_snapshots", fields: [superseded_by_id], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "balance_snapshots_superseded_id_fkey")
  other_account_balance_snapshots account_balance_snapshots[] @relation("account_balance_snapshotsToaccount_balance_snapshots")

  @@unique([ledger_account_id, business_date], map: "account_balance_snapshots_current_key", where: raw("is_current"))
  @@unique([ledger_account_id, business_date, calculation_version])
  @@index([financial_space_id, business_date])
  @@index([snapshot_run_id])
  @@index([status, business_date])
  @@index([superseded_by_id])
}

model accounts {
