MONGODB_URI_PRODUCTION=''
MONGODB_URI_DEVELOPMENT=''
DATABASE_NAME=''

# V2 remains disabled by default and cannot be enabled when DEPLOYMENT_ENV=production.
DEPLOYMENT_ENV='development'
ENABLE_API_V2='false'
ACTIVE_FINANCIAL_WRITE_VERSION='V1'
V2_FEATURE_FLAGS_JSON='{}'

# Local PostgreSQL. Supabase staging uses the separate .env.staging.example shape.
POSTGRES_USER='hey_money_v2'
POSTGRES_PASSWORD='hey_money_v2_local_only'
POSTGRES_DB='hey_money_v2'
POSTGRES_LOCAL_PORT=5432
POSTGRESQL_DATABASE_URL='postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public'
POSTGRESQL_DIRECT_URL='postgresql://hey_money_v2:hey_money_v2_local_only@localhost:5432/hey_money_v2?schema=public'

# V2 Redis and Agenda must not share production namespace/store/worker identity.
REDIS_URL='redis://localhost:6379'
V2_REDIS_NAMESPACE='hey-money:v2:local'
AGENDA_MONGODB_USER='agenda_v2'
AGENDA_MONGODB_PASSWORD='agenda_v2_local_only'
AGENDA_MONGODB_LOCAL_PORT=27018
AGENDA_MONGODB_URI='mongodb://agenda_v2:agenda_v2_local_only@localhost:27018/agenda_v2?authSource=admin'
AGENDA_DATABASE_NAME='agenda_v2'
V2_EMAIL_MODE='sink'
V2_SOCKET_MODE='disabled'
V2_NOTIFICATION_MODE='capture'

LOCAL_DEV_APP_HOST=''
LOCAL_DEV_APP_PORT=

AUTHOR=''

WEBSITE_DOMAIN_DEVELOPMENT=''
WEBSITE_DOMAIN_PRODUCTION=''

BREVO_API_KEY=''
ADMIN_EMAIL_ADDRESS=''
ADMIN_EMAIL_NAME=''

ACCESS_TOKEN_SECRET_SIGNATURE=''
ACCESS_TOKEN_LIFE=''

REFRESH_TOKEN_SECRET_SIGNATURE=''
REFRESH_TOKEN_LIFE=''

CLOUDINARY_CLOUD_NAME=''
CLOUDINARY_API_KEY=''
CLOUDINARY_API_SECRET=''
