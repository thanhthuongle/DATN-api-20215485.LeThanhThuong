BUILD_MODE='production'
DEPLOYMENT_ENV='staging'
ENABLE_API_V2='true'
ACTIVE_FINANCIAL_WRITE_VERSION='V1'
V2_FEATURE_FLAGS_JSON='{}'

# Supabase pooled runtime URL and direct migration/administration URL.
# Store real credentials only in the staging secret manager.
POSTGRESQL_DATABASE_URL='postgresql://<staging-runtime-user>:<secret>@<pooler-host>:6543/<database>?pgbouncer=true&connection_limit=10&schema=public&uselibpqcompat=true&sslmode=require'
POSTGRESQL_DIRECT_URL='postgresql://<staging-migration-user>:<secret>@<direct-host>:5432/<database>?schema=public&uselibpqcompat=true&sslmode=require'

# Dedicated staging Redis namespace and dedicated Agenda MongoDB store.
REDIS_URL='rediss://<staging-redis-host>:<port>'
V2_REDIS_NAMESPACE='hey-money:v2:staging'
AGENDA_MONGODB_URI='mongodb+srv://<agenda-staging-user>:<secret>@<agenda-staging-cluster>/<agenda-database>?retryWrites=true&w=majority'
AGENDA_DATABASE_NAME='agenda_v2_staging'

# External side effects remain isolated/disabled until their owning task is approved.
V2_EMAIL_MODE='sink'
V2_SOCKET_MODE='disabled'
V2_NOTIFICATION_MODE='capture'
